{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "tagliando-ai-staging",
  "main": "./worker/src/index.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SERVICE_MODE": "disabled",
    "ALLOWED_ORIGIN": "https://lupus227.github.io",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1404",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
