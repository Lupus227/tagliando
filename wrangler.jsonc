{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "tagliando-ai-staging",
  "main": "./worker/src/index.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SERVICE_MODE": "guarded",
    "AI_PROBE_MODE": "enabled",
    "AI_PROBE_EXPIRES_AT": "2026-11-13T00:00:00Z",
    "ALLOWED_ORIGIN": "https://lupus227.github.io",
    "ACCESS_TEAM_DOMAIN": "mute-poetry-bc89.cloudflareaccess.com",
    "ACCESS_AUD": "da3e295e300402c580d7282cece8300a1346ac0fcd32e34983dbb0dc2aca57c5",
    "SELF_TEST_ORIGIN": "https://tagliando-ai-staging.maico-gua.workers.dev"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_PROBE_LIMITER",
      "namespace_id": "1405",
      "simple": { "limit": 1, "period": 60 }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1404",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
